# Database Configuration
DATABASE_URL="file:./prisma/data/dev.db"

# OpenAI Configuration (default AI provider)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"

# AI provider selection (optional — defaults to openai for both)
#   AI_TRANSCRIPTION_PROVIDER: openai | google | whisper-local
#   AI_SUMMARY_PROVIDER:       openai | google
# AI_TRANSCRIPTION_PROVIDER="openai"
# AI_SUMMARY_PROVIDER="openai"
#
# Per-provider model overrides (optional):
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"
# OPENAI_SUMMARY_MODEL="gpt-4o"
# GOOGLE_TRANSCRIPTION_MODEL="gemini-2.5-flash"
# GOOGLE_SUMMARY_MODEL="gemini-2.5-flash"
#
# Google Gemini API key (required when using the google provider).
# Get one from: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
#
# Local whisper.cpp (required only when AI_TRANSCRIPTION_PROVIDER=whisper-local).
# Needs the optional "nodejs-whisper" package built (make/cmake/g++/python3 + ffmpeg).
# WHISPER_MODEL="base.en"
# WHISPER_MODELS_DIR="./whisper-models"
# WHISPER_USE_CUDA="false"

# Set MOCK_AI_SERVICES=true to bypass all real AI calls with deterministic
# fixtures (used by integration/smoke tests). Leave unset in normal operation.
# MOCK_AI_SERVICES="true"

# Voice speaker-embedding (fingerprints). When VOICE_EMBEDDING_MODEL_PATH is
# unset, or MOCK_AI_SERVICES=true, a deterministic mock embedder is used so no
# extra dependency is needed. Setting a model path selects the real ONNX
# (ECAPA-TDNN) backend, which requires the optional, glibc-only
# "onnxruntime-node" package (provisioned in the GPU/diarization environment).
# VOICE_EMBEDDING_MODEL_PATH="/models/ecapa-tdnn.onnx"

# NextAuth Configuration (Required)
# For development, use http://localhost:3000
# For production, use your domain (e.g., https://your-domain.com)
NEXTAUTH_URL="http://localhost:3000"
# Generate a secure secret: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-nextauth-secret"

# Google OAuth Configuration (Optional)
# Set up OAuth app at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_ENABLED="true"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="100000000"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"