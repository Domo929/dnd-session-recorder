# Database Configuration
DATABASE_URL="file:./prisma/data/dev.db"

# OpenAI Configuration (default AI provider)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"

# AI provider selection (optional — defaults to openai for both)
#   AI_TRANSCRIPTION_PROVIDER: openai | google | whisper-local
#   AI_SUMMARY_PROVIDER:       openai | google
# AI_TRANSCRIPTION_PROVIDER="openai"
# AI_SUMMARY_PROVIDER="openai"
#
# Per-provider model overrides (optional):
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"
# OPENAI_SUMMARY_MODEL="gpt-4o"
# GOOGLE_TRANSCRIPTION_MODEL="gemini-2.5-flash"
# GOOGLE_SUMMARY_MODEL="gemini-2.5-flash"
#
# Google Gemini API key (required when using the google provider).
# Get one from: https://aistudio.google.com/apikey
# GOOGLE_GENERATIVE_AI_API_KEY="your-gemini-api-key"
#
# Local whisper.cpp (required only when AI_TRANSCRIPTION_PROVIDER=whisper-local).
# Needs the optional "nodejs-whisper" package built (make/cmake/g++/python3 + ffmpeg).
# WHISPER_MODEL="base.en"
# WHISPER_MODELS_DIR="./whisper-models"
# WHISPER_USE_CUDA="false"
#
# Transcription pacing + adaptive backoff (optional). Chunks are transcribed
# sequentially; each provider call is paced under TRANSCRIPTION_MAX_RPM and
# rate-limit / overload errors are retried honoring the server's suggested
# delay (exponential fallback) before failing. Defaults are safe for Gemini.
# TRANSCRIPTION_MAX_RPM="60"            # max transcription requests per minute
# TRANSCRIPTION_CHUNK_MAX_RETRIES="5"   # backoff attempts per chunk before failing
# TRANSCRIPTION_BACKOFF_BASE_MS="5000"  # first fallback backoff when no server hint
# TRANSCRIPTION_BACKOFF_MAX_MS="60000"  # backoff cap

# Set MOCK_AI_SERVICES=true to bypass all real AI calls with deterministic
# fixtures (used by integration/smoke tests). Leave unset in normal operation.
# MOCK_AI_SERVICES="true"

# Voice speaker-embedding (fingerprints). When VOICE_EMBEDDING_MODEL_PATH is
# unset, or MOCK_AI_SERVICES=true, a deterministic mock embedder is used so no
# extra dependency is needed. Setting a model path selects the real ONNX
# (ECAPA-TDNN) backend, which requires the optional, glibc-only
# "onnxruntime-node" package (provisioned in the GPU/diarization environment).
# VOICE_EMBEDDING_MODEL_PATH="/models/ecapa-tdnn.onnx"

# Speaker-labels retention (cron). Audio is purged this many days after a
# speaker-labeled session is diarized; unknown-cluster review snippets are
# purged this many days after capture unless tagged. Defaults: 28 / 30.
# AUDIO_RETENTION_DAYS="28"
# UNKNOWN_SNIPPET_RETENTION_DAYS="30"
# Shared secret for the retention cron routes (/api/cron/audio-retention and
# /api/cron/snippet-purge). The external scheduler (deploy repo) sends it as
# "Authorization: Bearer <CRON_SECRET>". Unset = cron endpoints reject all calls.
# CRON_SECRET="a-long-random-string"

# Speaker-labels diarization dispatcher (GPU container orchestration, design §4).
# The in-app dispatcher launches an Azure Container Instances (ACI) GPU container
# per queued speaker-labeled session, then a cleanup loop reaps finished/stuck
# containers. The dispatcher stays DORMANT (fail closed) unless DIARIZATION_IMAGE,
# a callback base URL, AZURE_SUBSCRIPTION_ID and DIARIZATION_ACI_RESOURCE_GROUP are
# all set. ACI auth uses the App Service managed identity (DefaultAzureCredential).
# DIARIZATION_IMAGE="ghcr.io/domo929/dnd-recorder-diarization:latest"
# AZURE_SUBSCRIPTION_ID="00000000-0000-0000-0000-000000000000"
# DIARIZATION_ACI_RESOURCE_GROUP="dnd-recorder-rg"
# Public base URL the container POSTs results back to (defaults to NEXTAUTH_URL).
# DIARIZATION_CALLBACK_BASE_URL="https://your-domain.com"
# Regions tried in order; the first to accept the GPU container wins. Default:
# centralus,westus2,eastus2
# DIARIZATION_REGIONS="centralus,westus2,eastus2"
# Cost guardrails. Daily spend is fail-closed unless a session sets bypassBudget.
# Defaults: 5 USD/day, 3 concurrent, 1 per campaign, 0.30 USD/session estimate.
# DIARIZATION_MAX_DAILY_USD="5"
# DIARIZATION_MAX_CONCURRENT="3"
# DIARIZATION_MAX_PER_CAMPAIGN="1"
# DIARIZATION_COST_PER_SESSION_USD="0.30"
# Lifetime of the read-only SAS handed to the container for the session audio.
# Default: 120 minutes.
# DIARIZATION_SAS_TTL_MINUTES="120"
# GPU SKU requested for the ACI container group (design intent: T4). Note Azure
# ACI GPU SKUs are region/quota gated; the deploy repo owns provisioning.
# DIARIZATION_GPU_SKU="T4"
# HuggingFace access token for the gated pyannote/speaker-diarization-3.1 model.
# Passed to the diarization container so it can download the model at runtime.
# Create at https://huggingface.co/settings/tokens after accepting the model's
# terms at https://huggingface.co/pyannote/speaker-diarization-3.1
# HUGGINGFACE_TOKEN="hf_..."


# NextAuth Configuration (Required)
# For development, use http://localhost:3000
# For production, use your domain (e.g., https://your-domain.com)
NEXTAUTH_URL="http://localhost:3000"
# Generate a secure secret: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-nextauth-secret"

# Google OAuth Configuration (Optional)
# Set up OAuth app at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_ENABLED="true"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="100000000"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"