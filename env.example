# Database Configuration
DATABASE_URL="file:./prisma/data/dev.db"

# AI Provider Selection
# - openai (default): use OpenAI Whisper + GPT-4o
# - google: use Google Gemini multimodal (transcription + summary)
# - whisper-local: run whisper.cpp locally (transcription only; pair with openai or google for summaries)
AI_TRANSCRIPTION_PROVIDER="openai"
AI_SUMMARY_PROVIDER="openai"

# OpenAI Configuration (required when either *_PROVIDER=openai)
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY="your-openai-api-key"
# Optional model overrides (defaults shown)
# OPENAI_SUMMARY_MODEL="gpt-4o"
# OPENAI_TRANSCRIPTION_MODEL="whisper-1"

# Google Generative AI Configuration (required when either *_PROVIDER=google)
# Get your API key from: https://aistudio.google.com/apikey
GOOGLE_GENERATIVE_AI_API_KEY="your-google-generative-ai-api-key"
# Optional model overrides (defaults shown)
# GOOGLE_SUMMARY_MODEL="gemini-2.5-flash"
# GOOGLE_TRANSCRIPTION_MODEL="gemini-2.5-flash"

# Local Whisper (whisper.cpp) Configuration
# Only used when AI_TRANSCRIPTION_PROVIDER="whisper-local".
# Requires the optional "nodejs-whisper" package to build successfully
# (needs ffmpeg, make, cmake, g++, and python3 on the host).
# Trigger the one-time compile + model download with: npx nodejs-whisper download
# Model list: tiny | tiny.en | base | base.en | small | small.en | medium | medium.en | large-v3 | large-v3-turbo
# WHISPER_MODEL="base.en"
# WHISPER_MODELS_DIR — optional. When unset, models are read from
#   node_modules/nodejs-whisper/cpp/whisper.cpp/models/ (same path the CLI
#   downloader uses). Override when you want models to live elsewhere
#   (e.g. /app/whisper-models in Docker for volume persistence).
# WHISPER_MODELS_DIR=""
# WHISPER_USE_CUDA="false"

# NextAuth Configuration (Required)
# For development, use http://localhost:3000
# For production, use your domain (e.g., https://your-domain.com)
NEXTAUTH_URL="http://localhost:3000"
# Generate a secure secret: https://generate-secret.vercel.app/32
NEXTAUTH_SECRET="your-nextauth-secret"

# Google OAuth Configuration (Optional)
# Set up OAuth app at: https://console.cloud.google.com/apis/credentials
# Authorized redirect URIs: http://localhost:3000/api/auth/callback/google
GOOGLE_CLIENT_ID="your-google-client-id"
GOOGLE_CLIENT_SECRET="your-google-client-secret"
NEXT_PUBLIC_GOOGLE_ENABLED="true"

# File Upload Configuration
UPLOAD_DIR="./uploads"
MAX_FILE_SIZE="100000000"

# CORS Configuration
CORS_ORIGIN="http://localhost:3000"
