# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage
/nyc_output/

# playwright testing
/test-results*
/playwright-report/
/playwright-report-workflows/
/blob-report/
/playwright/.cache/
*.pwtest-*
test-results-*.json

# next.js
/.next/
/out/

# production
/build
/dist/

# typescript
*.tsbuildinfo
next-env.d.ts
*.d.ts.map
*.js.map

# database files
/prisma/data/
*.db
*.db-journal
*.db-shm
*.db-wal

# uploads and file storage
/uploads/
/data/
/tmp/

# environment variables
.env*

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*
/logs/
build.log

# IDE and editor files
.vscode/
.idea/
*.swp
*.swo
*~

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# misc
*.pem

# vercel
.vercel

# Claude AI assistant files
.claude/
# Ignore docs/ by default (upstream convention) but keep our design/plan docs.
docs/*
!docs/plans/

# git worktrees (we create feature worktrees under .worktrees/)
.worktrees/

# Stray tsc emission inside src/ — Next.js handles bundling, so any .js / .d.ts
# next to a .ts is a stale artifact that will shadow the real source at build
# time (Webpack resolves .js before .ts when both exist). Keep hand-authored
# ambient type declarations under src/types/.
/src/**/*.js
/src/**/*.js.map
/src/**/*.d.ts
/src/**/*.d.ts.map
!/src/types/*.d.ts